<Window x:Class="VoxFlow.UI.WhisperHudWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="VoxFlow Whisper HUD"
        Width="350" Height="48"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        Topmost="True"
        ShowInTaskbar="False"
        ShowActivated="False"
        ResizeMode="NoResize"
        MouseLeftButtonDown="Window_MouseLeftButtonDown">
    <Border x:Name="PillBorder"
            CornerRadius="24"
            Background="#F210131C"
            BorderBrush="#556366F1"
            BorderThickness="1.5"
            Padding="14,6"
            Margin="4">
        <Border.Effect>
            <DropShadowEffect Color="#000000" BlurRadius="14" ShadowDepth="3" Opacity="0.65"/>
        </Border.Effect>
        <Grid VerticalAlignment="Center">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <!-- Live Pulsing Indicator Dot -->
            <Ellipse x:Name="RecDot"
                     Grid.Column="0"
                     Width="8" Height="8"
                     Fill="#EF4444"
                     VerticalAlignment="Center"
                     Margin="0,0,9,0"/>

            <!-- 8-Bar Whisper Voice Waveform -->
            <StackPanel Grid.Column="1"
                        Orientation="Horizontal"
                        VerticalAlignment="Center"
                        Height="24"
                        Margin="0,0,10,0">
                <Border x:Name="Bar0" Width="3" Height="5" CornerRadius="1.5" Background="#818CF8" VerticalAlignment="Center" Margin="1,0"/>
                <Border x:Name="Bar1" Width="3" Height="8" CornerRadius="1.5" Background="#818CF8" VerticalAlignment="Center" Margin="1,0"/>
                <Border x:Name="Bar2" Width="3" Height="12" CornerRadius="1.5" Background="#A5B4FC" VerticalAlignment="Center" Margin="1,0"/>
                <Border x:Name="Bar3" Width="3" Height="16" CornerRadius="1.5" Background="#C7D2FE" VerticalAlignment="Center" Margin="1,0"/>
                <Border x:Name="Bar4" Width="3" Height="14" CornerRadius="1.5" Background="#C7D2FE" VerticalAlignment="Center" Margin="1,0"/>
                <Border x:Name="Bar5" Width="3" Height="10" CornerRadius="1.5" Background="#A5B4FC" VerticalAlignment="Center" Margin="1,0"/>
                <Border x:Name="Bar6" Width="3" Height="7" CornerRadius="1.5" Background="#818CF8" VerticalAlignment="Center" Margin="1,0"/>
                <Border x:Name="Bar7" Width="3" Height="5" CornerRadius="1.5" Background="#818CF8" VerticalAlignment="Center" Margin="1,0"/>
            </StackPanel>

            <!-- Live Preview / Status Text -->
            <TextBlock x:Name="HudStatusText"
                       Grid.Column="2"
                       Text="Слухаю..."
                       Foreground="#F3F4F6"
                       FontSize="12.5"
                       FontWeight="Medium"
                       VerticalAlignment="Center"
                       TextTrimming="CharacterEllipsis"
                       Margin="0,0,8,0"/>

            <!-- Timer -->
            <TextBlock x:Name="HudTimerText"
                       Grid.Column="3"
                       Text="00:00"
                       Foreground="#9CA3AF"
                       FontFamily="Consolas"
                       FontSize="11.5"
                       VerticalAlignment="Center"
                       Margin="0,0,8,0"/>

            <!-- Stop Button -->
            <Button x:Name="HudStopBtn"
                    Grid.Column="4"
                    Click="HudStopBtn_Click"
                    Cursor="Hand"
                    ToolTip="Зупинити запис"
                    Width="24" Height="24"
                    VerticalAlignment="Center">
                <Button.Template>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="StopBg" CornerRadius="12" Background="#33EF4444" BorderBrush="#66EF4444" BorderThickness="1">
                            <Rectangle Width="8" Height="8" Fill="#F87171" RadiusX="1.5" RadiusY="1.5" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="StopBg" Property="Background" Value="#66EF4444"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Button.Template>
            </Button>
        </Grid>
    </Border>
</Window>
